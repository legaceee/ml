# ==============================================================================
# Datasets (large; rebuilt with `python -m ml.data.build_dataset --download --build`)
# ==============================================================================
ml/data/raw/cicids2017_full/
ml/data/raw/cicids2017_dev_sample.csv
ml/data/splits/
# The 19 MB class-capped sample (cicids2017_sample.csv + manifest) IS committed so
# anyone can reproduce the results without the 885 MB download.

# Trained models are regenerated by `python -m ml.training.run_all_experiments`
# (some exceed 20 MB; the preprocessor is kept because it is small and the API needs it)
ml/artifacts/models/*.joblib
ml/artifacts/experiments/run_log.txt
ml/artifacts/experiments/run_err.txt
